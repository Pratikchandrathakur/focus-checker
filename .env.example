# Copy to .env.local and fill in from Supabase → Project Settings → API.
# The anon key is safe in the browser ONLY because Row Level Security is on (supabase/schema.sql).
# Never put the service_role key in this app.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# --- Pro checkout (optional; Pro stays "coming soon" until ALL THREE of the first lines are set) ---
# Hosted checkout links from your payment provider. https only.
VITE_CHECKOUT_MONTHLY=
VITE_CHECKOUT_YEARLY=
# Comma-separated hostnames those links may use. Anything else is refused (no open redirects).
VITE_CHECKOUT_HOSTS=
# Optional: how your provider takes the account id / email in the checkout URL, and the self-service billing page.
# VITE_CHECKOUT_USER_PARAM=checkout[custom][user_id]
# VITE_CHECKOUT_EMAIL_PARAM=checkout[email]
# VITE_BILLING_PORTAL_URL=
